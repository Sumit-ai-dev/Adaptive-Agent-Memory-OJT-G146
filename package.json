{
  "name": "adaptive-agent-memory",
  "version": "2.0.0",
  "private": true,
  "description": "Reliability-Aware Experiential Memory for AI Agents",
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build && npm --prefix packages/aema run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:sdk": "npm --prefix packages/aema run build",
    "build:extension": "node scripts/build_extension.mjs",
    "test:sdk": "npm --prefix packages/aema test"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "author": "Sakshi Kasat & Sumit Das",
  "license": "MIT"
}
