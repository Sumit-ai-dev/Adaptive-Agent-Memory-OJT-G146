# ==============================================================================
# Environment Configuration Template for AEMA Vultr Deployment
# Copy this file to .env on your Vultr server: cp deploy/.env.vultr.example .env
# ==============================================================================

# Backend Gateway Port & Storage
PORT=8000
STORAGE_ENGINE=sqlite
AEMA_DB_PATH=/data/adaptive_memory.db

# Multi-Provider LLM Keys (optional on server if users supply BYOK in browser)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Security & Admin Access
ADMIN_API_KEY=
ENVIRONMENT=production

# Database (only if using distributed PostgreSQL + pgvector via docker-compose)
POSTGRES_DB=aema_db
POSTGRES_USER=aema
POSTGRES_PASSWORD=generate_a_secure_password_here
POSTGRES_PORT=5432
