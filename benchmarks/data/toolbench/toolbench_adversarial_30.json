    {
      "id": "tb_dep_011",
      "query": "Find the Wikipedia article about transformer architecture, then extract the year it was introduced, then search for papers published that year about attention mechanisms.",
      "steps": [
        {
          "tool": "wikipedia_search",
          "params": {
            "query": "Transformer architecture AI"
          }
        },
        {
          "tool": "extract_year",
          "params": {
            "text": "{{step_1_output}}"
          }
        },
        {
          "tool": "semantic_scholar",
          "params": {
            "query": "attention mechanism",
            "year": "{{step_2_output}}",
            "limit": 5
          }
        }
      ],
      "trap_type": "dependency_chain",
      "trap_description": "Step 3 fails if Step 2 output is not passed correctly (agent often uses raw text instead of extracted year)",
      "category": "multi_step_dependency",
      "source": "toolbench_curated_adversarial"
