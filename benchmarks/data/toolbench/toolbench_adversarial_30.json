    {
      "id": "tb_dep_001",
      "query": "Search for the latest news about AI safety from the past week.",
      "tools": [
        {
          "name": "web_search",
          "description": "Search the web",
          "params": {
            "query": "str",
            "days": "int"
          }
        }
      ],
      "trap_type": "deprecated_param",
      "trap_description": "Agent may use 'recency=7' (old param) instead of 'days=7' (new param)",
      "correct_call": {
        "tool": "web_search",
        "params": {
          "query": "AI safety news",
          "days": 7
        }
      },
      "wrong_call": {
        "tool": "web_search",
        "params": {
          "query": "AI safety news",
          "recency": 7
        }
      },
      "expected_error": "TypeError: unexpected keyword argument 'recency'",
      "category": "deprecated_parameter",
      "source": "toolbench_curated_adversarial"
    },
