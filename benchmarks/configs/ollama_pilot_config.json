{
  "experiment_name": "AEMA_Phase4A_Ollama_Local_Pilot",
  "version": "1.0.0",
  "description": "Reproducible Phase 4A MemoryAgentBench Pilot Evaluation using local Ollama LLM",
  "provenance": {
    "benchmark": "MemoryAgentBench",
    "paper": "Evaluating Memory in LLM Agents via Incremental Multi-Turn Interactions (ICLR 2026)",
    "upstream_dataset": "ai-hyz/MemoryAgentBench",
    "split_conflict_resolution": "factconsolidation_sh_6k",
    "split_accurate_retrieval": "ruler_qa1_197K",
    "split_test_time_learning": "icl_trec_coarse_6600shot_balance",
    "split_long_range_understanding": "detective_qa"
  },
  "hardware_requirements": {
    "min_ram_gb": 8,
    "recommended_gpu": "NVIDIA RTX 3060/4060 or higher (>=8 GB VRAM)",
    "local_server": "Ollama (http://localhost:11434)"
  },
  "ollama_configuration": {
    "provider": "ollama",
    "base_url": "http://localhost:11434",
    "recommended_models": {
      "high_tier_16gb_plus": "llama3.1:8b",
      "mid_tier_8gb": "llama3.1:8b",
      "entry_tier_cpu": "llama3.2:3b"
    },
    "generation_parameters": {
      "temperature": 0.0,
      "max_tokens": 256,
      "seed": 42
    }
  },
  "experimental_conditions": [
    {
      "name": "vanilla",
      "mode": "off",
      "memory_enabled": false,
      "description": "Baseline without external memory"
    },
    {
      "name": "naive_rag",
      "mode": "naive",
      "memory_enabled": true,
      "description": "Cosine vector retrieval"
    },
    {
      "name": "recency",
      "mode": "recency",
      "memory_enabled": true,
      "description": "Cosine similarity with exponential recency decay"
    },
    {
      "name": "symmetric",
      "mode": "symmetric",
      "memory_enabled": true,
      "description": "Reliability-aware retrieval without quarantine"
    },
    {
      "name": "adaptive",
      "mode": "adaptive",
      "memory_enabled": true,
      "description": "Full AEMA: Epistemic conflict detection, asymmetric Bayesian update, quarantine cutoff (theta=0.35)"
    }
  ],
  "evaluation_protocol": {
    "official_metric": "substring_exact_match",
    "secondary_metrics": ["exact_match", "token_f1"],
    "diagnostic_metrics": ["is_obsolete_fact_intrusion", "quarantine_triggered", "quarantine_blocked_poison"],
    "telemetry_format": "jsonl",
    "summary_format": "csv"
  }
}
